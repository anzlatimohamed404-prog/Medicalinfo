<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Médecins - Medicalinfo</title>
    <!-- Lien vers le fichier CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Barre de navigation -->
    <nav>
        <a href="/api/patients">👤 Patients</a>
        <a href="/api/medecins">🩺 Médecins</a>
        <a href="/api/services">🏥 Services</a>
        <a href="/api/rendezvous">📅 Rendez-vous</a>
    </nav>

    <div class="container">

        <h1>🩺 Médecins</h1>

        <!-- Tableau des médecins -->
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Spécialité</th>
                    <th>Service</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% resultatMedecins.forEach(medecin => { %>
                <tr>
                    <td><%= medecin.nom %></td>
                    <td><%= medecin.prenom %></td>
                    <td><%= medecin.specialite %></td>
                    <td><%= medecin.service_affecte %></td>
                    <td>
                        <button class="btn-supprimer" onclick="supprimer(<%= medecin.id_medecin %>)">🗑️ Supprimer</button>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <h2>Ajouter un Médecin</h2>

        <!-- Formulaire d'ajout -->
        <form action="/api/medecins" method="POST">
            <input type="text" name="nom" placeholder="Nom" required>
            <input type="text" name="prenom" placeholder="Prénom" required>
            <input type="text" name="specialite" placeholder="Spécialité" required>
            <input type="text" name="service_affecte" placeholder="Service affecté" required>
            <button type="submit">➕ Ajouter Médecin</button>
        </form>

    </div>

    <script>
        function supprimer(id) {
            fetch(`/api/medecins/${id}`, { method: 'DELETE' })
            .then(res => { if (res.ok) location.reload(); })
            .catch(err => alert("Erreur lors de la suppression"));
        }
    </script>

</body>
</html>