<!DOCTYPE html>
<html>
<head>
    <title>Liste des Médecins</title>
</head>
<body>
    <h1>Médecins</h1>
    <ul>
        <% resultatMedecins.forEach(medecin => { %>
            <li><%= medecin.nom %> <%= medecin.prenom %> - <%= medecin.specialite %></li>
        <% }) %>
    </ul>
    <a href="/api/accueil">Retour à l'accueil</a>
</body>
</html>

<h2>Ajouter un Médecin</h2>

<!-- Formulaire qui envoie les données à la route POST /api/medecins -->
<form action="/api/medecins" method="POST">
    <!-- Champ pour le nom du médecin -->
    <input type="text" name="nom" placeholder="Nom" required><br>

    <!-- Champ pour le prénom du médecin -->
    <input type="text" name="prenom" placeholder="Prénom" required><br>

    <!-- Champ pour la spécialité du médecin -->
    <input type="text" name="specialite" placeholder="Spécialité" required><br>

    <!-- Champ pour le service où il est affecté -->
    <input type="text" name="service_affecte" placeholder="Service affecté" required><br>

    <!-- Bouton pour envoyer le formulaire -->
    <button type="submit">Ajouter Médecin</button>
</form>