<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <!-- Encodage UTF-8 -->

    <title>Rendez-vous - Medicalinfo</title>
    <!-- Titre de l'onglet -->

    <link rel="stylesheet" href="/css/style.css">
    <!-- Lien vers le fichier CSS -->

</head>
<body>

    <!-- Barre de navigation -->
    <nav>
        <a href="/api/patients">👤 Patients</a>
        <!-- Lien patients -->

        <a href="/api/medecins">🩺 Médecins</a>
        <!-- Lien médecins -->

        <a href="/api/services">🏥 Services</a>
        <!-- Lien services -->

        <a href="/api/rendezvous">📅 Rendez-vous</a>
        <!-- Lien rendez-vous -->
    </nav>

    <div class="container">
    <!-- Conteneur principal -->

        <h1>📅 Rendez-vous</h1>
        <!-- Titre de la page -->

        <table>
        <!-- Tableau des rendez-vous -->

            <thead>
            <!-- En-tête du tableau -->

                <tr>
                    <th>ID</th>
                    <!-- Colonne id -->

                    <th>Patient ID</th>
                    <!-- Colonne patient -->

                    <th>Médecin ID</th>
                    <!-- Colonne médecin -->

                    <th>Date</th>
                    <!-- Colonne date -->

                    <th>Motif</th>
                    <!-- Colonne motif -->

                    <th>Statut</th>
                    <!-- Colonne statut -->

                    <th>Action</th>
                    <!-- Colonne action -->
                </tr>
            </thead>

            <tbody>
            <!-- Corps du tableau -->

                <% if (resultatRdv && resultatRdv.length > 0) { %>
                <!-- Vérifie si des rendez-vous existent -->

                    <% resultatRdv.forEach(rdv => { %>
                    <!-- Parcourt chaque rendez-vous -->

                        <tr>

                            <td><%= rdv.id_rdv %></td>
                            <!-- Affiche l'id -->

                            <td><%= rdv.patient_id %></td>
                            <!-- Affiche l'id du patient -->

                            <td><%= rdv.medecin_id %></td>
                            <!-- Affiche l'id du médecin -->

                            <td>
                                <span class="date-badge"><%= new Date(rdv.date_rdv).toLocaleString('fr-FR') %></span>
                                <!-- Formate la date en français avec badge bleu -->
                            </td>

                            <td><%= rdv.motif %></td>
                            <!-- Affiche le motif -->

                            <td>
                                <% if (rdv.statut === 'prévu') { %>
                                <!-- Statut prévu → badge vert -->
                                    <span class="statut-prevu"><%= rdv.statut %></span>

                                <% } else if (rdv.statut === 'terminé') { %>
                                <!-- Statut terminé → badge gris -->
                                    <span class="statut-termine"><%= rdv.statut %></span>

                                <% } else if (rdv.statut === 'annulé') { %>
                                <!-- Statut annulé → badge rouge -->
                                    <span class="statut-annule"><%= rdv.statut %></span>

                                <% } %>
                                <!-- Fin de la condition statut -->
                            </td>

                            <td>
                                <button class="btn-supprimer" onclick="supprimerRdv(<%= rdv.id_rdv %>)">🗑️ Supprimer</button>
                                <!-- Bouton supprimer -->
                            </td>

                        </tr>
                        <!-- Fin de la ligne -->

                    <% }) %>
                    <!-- Fin de la boucle -->

                <% } else { %>
                <!-- Si aucun rendez-vous -->

                    <tr>
                        <td colspan="7" style="text-align:center; color:#999;">
                            Aucun rendez-vous pour le moment
                        </td>
                        <!-- Message si liste vide -->
                    </tr>

                <% } %>
                <!-- Fin du if/else -->

            </tbody>

        </table>
        <!-- Fin du tableau -->

        <h2>Ajouter un Rendez-vous</h2>
        <!-- Titre du formulaire -->

        <form action="/api/rendezvous" method="POST">
        <!-- Formulaire d'ajout -->

            <input type="number" name="patient_id" placeholder="ID du patient" required>
            <!-- Champ id patient -->

            <input type="number" name="medecin_id" placeholder="ID du médecin" required>
            <!-- Champ id médecin -->

            <input type="datetime-local" name="date_rdv" required>
            <!-- Champ date et heure -->

            <input type="text" name="motif" placeholder="Motif" required>
            <!-- Champ motif -->

            <select name="statut" required>
            <!-- Menu déroulant statut -->

                <option value="">-- Choisir un statut --</option>
                <!-- Option par défaut -->

                <option value="prévu">Prévu</option>
                <!-- Statut prévu -->

                <option value="annulé">Annulé</option>
                <!-- Statut annulé -->

                <option value="terminé">Terminé</option>
                <!-- Statut terminé -->

            </select>
            <!-- Fin du menu déroulant -->

            <button type="submit">➕ Ajouter Rendez-vous</button>
            <!-- Bouton d'envoi -->

        </form>
        <!-- Fin du formulaire -->

    </div>
    <!-- Fin du conteneur -->

    <script>

        function supprimerRdv(id) {
        // Fonction de suppression d'un rendez-vous

            fetch(`/api/rendezvous/${id}`, { method: 'DELETE' })
            // Envoie la requête DELETE avec l'id

            .then(res => {
            // Quand le serveur répond

                if (res.ok) location.reload();
                // Recharge la page si succès
            })
            .catch(err => alert("Erreur lors de la suppression"));
            // Affiche une erreur si problème
        }

    </script>
    <!-- Fin du script -->

</body>
</html>