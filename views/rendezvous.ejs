<!-- Déclare que ce document est un document HTML5 conforme aux standards du web -->
<!DOCTYPE html>

<!-- Ouvre la balise racine HTML avec l'attribut lang="fr" pour indiquer que le contenu est en français, améliorant l'accessibilité et le SEO -->
<html lang="fr">

<!-- Ouvre la section head du document HTML, qui contient les métadonnées invisibles pour le navigateur -->
<head>

    <!-- Définit l'encodage des caractères de la page comme UTF-8, permettant d'afficher correctement les caractères accentués et spéciaux -->
    <meta charset="UTF-8">

    <!-- Définit le titre de la page web, affiché dans l'onglet du navigateur et utilisé pour le référencement -->
    <title>Rendez-vous - Medicalinfo</title>

    <!-- Lie une feuille de style CSS externe située dans le dossier public/css, pour appliquer des styles visuels à la page -->
    <link rel="stylesheet" href="/css/style.css">

<!-- Ferme la section head du document -->
</head>

<body>
<!-- Corps de la page -->

    <nav>
    <!-- Barre de navigation -->

        <a href="/api/accueil">🏠 Accueil</a>
        <!-- Lien vers la page d'accueil -->

        <a href="/api/patients">👤 Patients</a>
        <!-- Lien vers la page des patients -->

        <a href="/api/medecins">🩺 Médecins</a>
        <!-- Lien vers la page des médecins -->

        <a href="/api/services">🏥 Services</a>
        <!-- Lien vers la page des services -->

        <a href="/api/rendezvous">📅 Rendez-vous</a>
        <!-- Lien vers la page des rendez-vous -->

        <a href="/recherche">🔍 Recherche</a>

    </nav>
    <!-- Fin de la barre de navigation -->

    <div class="container">
    <!-- Conteneur principal centré -->

        <h1>📅 Rendez-vous</h1>
        <!-- Titre principal de la page -->

        <div id="clock" style="font-size: 24px; font-weight: bold; color: #7e57c2; text-align: center; margin-bottom: 20px;">
        <!-- Horloge affichant l'heure actuelle en violet doux -->
        </div>

        <table>
        <!-- Tableau d'affichage des rendez-vous -->

            <thead>
            <!-- En-tête du tableau -->

                <tr>
                <!-- Ligne d'en-tête -->

                    <th>ID</th>
                    <!-- Colonne identifiant du rendez-vous -->

                    <th>Patient ID</th>
                    <!-- Colonne identifiant du patient -->

                    <th>Médecin ID</th>
                    <!-- Colonne identifiant du médecin -->

                    <th>Date</th>
                    <!-- Colonne date du rendez-vous -->

                    <th>Motif</th>
                    <!-- Colonne motif du rendez-vous -->

                    <th>Statut</th>
                    <!-- Colonne statut du rendez-vous -->

                    <th>Action</th>
                    <!-- Colonne boutons d'action -->

                </tr>
                <!-- Fin de la ligne d'en-tête -->

            </thead>
            <!-- Fin de l'en-tête du tableau -->

            <tbody>
            <!-- Corps du tableau avec les données -->

                <% if (resultatRdv && resultatRdv.length > 0) { %>
                <!-- Vérifie si la liste des rendez-vous n'est pas vide -->

                    <% resultatRdv.forEach(rdv => { %>
                    <!-- Boucle sur chaque rendez-vous de la liste -->

                        <tr>
                        <!-- Ligne pour un rendez-vous -->

                            <td><%= rdv.id_rdv %></td>
                            <!-- Affiche l'identifiant du rendez-vous -->

                            <td><%= rdv.patient_id %></td>
                            <!-- Affiche l'identifiant du patient -->

                            <td><%= rdv.medecin_id %></td>
                            <!-- Affiche l'identifiant du médecin -->

                            <td>
                            <!-- Cellule de la date -->

                                <span class="date-badge"><%= new Date(rdv.date_rdv).toLocaleString('fr-FR') %></span>
                                <!-- Affiche la date formatée en français avec un badge bleu -->

                            </td>
                            <!-- Fin de la cellule date -->

                            <td><%= rdv.motif %></td>
                            <!-- Affiche le motif du rendez-vous -->

                            <td>
                            <!-- Cellule du statut -->

                                <% if (rdv.statut === 'prévu') { %>
                                <!-- Si le statut est prévu -->

                                    <span class="statut-prevu"><%= rdv.statut %></span>
                                    <!-- Affiche le statut avec badge vert -->

                                <% } else if (rdv.statut === 'terminé') { %>
                                <!-- Si le statut est terminé -->

                                    <span class="statut-termine"><%= rdv.statut %></span>
                                    <!-- Affiche le statut avec badge gris -->

                                <% } else if (rdv.statut === 'annulé') { %>
                                <!-- Si le statut est annulé -->

                                    <span class="statut-annule"><%= rdv.statut %></span>
                                    <!-- Affiche le statut avec badge rouge -->

                                <% } %>
                                <!-- Fin de la condition sur le statut -->

                            </td>
                            <!-- Fin de la cellule statut -->

                            <td>
                            <!-- Cellule des actions -->

                                <button class="btn-supprimer" onclick="supprimerRdv(<%= rdv.id_rdv %>)">🗑️ Supprimer</button>
                                <!-- Bouton pour supprimer le rendez-vous -->

                            </td>
                            <!-- Fin de la cellule actions -->

                        </tr>
                        <!-- Fin de la ligne du rendez-vous -->

                    <% }) %>
                    <!-- Fin de la boucle forEach -->

                <% } else { %>
                <!-- Si aucun rendez-vous n'existe -->

                    <tr>
                    <!-- Ligne de message vide -->

                        <td colspan="7" style="text-align:center; color:#999;">
                        <!-- Cellule fusionnée sur 7 colonnes -->

                            Aucun rendez-vous pour le moment
                            <!-- Message affiché quand la liste est vide -->

                        </td>
                        <!-- Fin de la cellule -->

                    </tr>
                    <!-- Fin de la ligne vide -->

                <% } %>
                <!-- Fin du if/else -->

            </tbody>
            <!-- Fin du corps du tableau -->

        </table>
        <!-- Fin du tableau -->

        <h2>Ajouter un Rendez-vous</h2>
        <!-- Titre du formulaire d'ajout -->

        <form action="/api/rendezvous" method="POST">
        <!-- Formulaire qui envoie les données en POST vers l'API -->

            <div class="form-group">
            <!-- Groupe champ + label pour l'id patient -->

                <label for="patient_id">ID du patient</label>
                <!-- Label visible au-dessus du champ patient -->

                <input type="number" id="patient_id" name="patient_id" placeholder="ID du patient" required>
                <!-- Champ numérique pour saisir l'id du patient -->

            </div>
            <!-- Fin du groupe patient -->

            <div class="form-group">
            <!-- Groupe champ + label pour l'id médecin -->

                <label for="medecin_id">ID du médecin</label>
                <!-- Label visible au-dessus du champ médecin -->

                <input type="number" id="medecin_id" name="medecin_id" placeholder="ID du médecin" required>
                <!-- Champ numérique pour saisir l'id du médecin -->

            </div>
            <!-- Fin du groupe médecin -->

            <div class="form-group">
            <!-- Groupe champ + label pour la date -->

                <label for="date_rdv">Date et heure</label>
                <!-- Label visible au-dessus du champ date -->

                <input type="datetime-local" id="date_rdv" name="date_rdv" required>
                <!-- Champ pour choisir la date et l'heure du rendez-vous -->

            </div>
            <!-- Fin du groupe date -->

            <div class="form-group">
            <!-- Groupe champ + label pour le motif -->

                <label for="motif">Motif</label>
                <!-- Label visible au-dessus du champ motif -->

                <input type="text" id="motif" name="motif" placeholder="Motif" required>
                <!-- Champ texte pour saisir le motif du rendez-vous -->

            </div>
            <!-- Fin du groupe motif -->

            <div class="form-group">
            <!-- Groupe champ + label pour le statut -->

                <label for="statut">Statut</label>
                <!-- Label visible au-dessus du menu déroulant -->

                <select id="statut" name="statut" required>
                <!-- Menu déroulant pour choisir le statut -->

                    <option value="">-- Choisir un statut --</option>
                    <!-- Option par défaut non sélectionnable -->

                    <option value="prévu">Prévu</option>
                    <!-- Option statut prévu -->

                    <option value="annulé">Annulé</option>
                    <!-- Option statut annulé -->

                    <option value="terminé">Terminé</option>
                    <!-- Option statut terminé -->

                </select>
                <!-- Fin du menu déroulant -->

            </div>
            <!-- Fin du groupe statut -->

            <button type="submit">➕ Ajouter Rendez-vous</button>
            <!-- Bouton pour soumettre le formulaire -->

        </form>
        <!-- Fin du formulaire -->

    </div>
    <!-- Fin du conteneur principal -->

    <style>
    /* Styles pour les groupes du formulaire */

        .form-group {
            display: flex;
            /* Affichage en colonne pour empiler label et input */

            flex-direction: column;
            /* Label au-dessus, input en dessous */

            margin-bottom: 10px;
            /* Espace entre chaque groupe de champ */
        }

        .form-group label {
            font-size: 12px;
            /* Taille du texte du label */

            color: #666;
            /* Couleur grise pour le label */

            margin-bottom: 4px;
            /* Espace entre le label et l'input */

            font-weight: 500;
            /* Texte légèrement gras */
        }

    </style>
    <!-- Fin des styles -->

    <script>
    /* Script JavaScript pour la suppression et l'horloge */

        function supprimerRdv(id) {
        /* Fonction appelée au clic sur le bouton supprimer */

            fetch(`/api/rendezvous/${id}`, { method: 'DELETE' })
            /* Envoie une requête DELETE à l'API avec l'id du rendez-vous */

            .then(res => {
            /* Quand le serveur répond */

                if (res.ok) location.reload();
                /* Si la suppression a réussi, recharge la page */

            })
            .catch(err => alert("Erreur lors de la suppression"));
            /* Affiche une alerte en cas d'erreur réseau */
        }

        function updateClock() {
        /* Fonction pour mettre à jour l'horloge */

            const now = new Date();
            /* Obtient la date et l'heure actuelles */

            const timeString = now.toLocaleTimeString('fr-FR');
            /* Formate l'heure au format français */

            document.getElementById('clock').textContent = 'Heure actuelle : ' + timeString;
            /* Affiche l'heure dans le div clock */
        }

        setInterval(updateClock, 1000);
        /* Met à jour l'horloge toutes les secondes */

        updateClock();
        /* Met à jour immédiatement au chargement de la page */

    </script>
    <!-- Fin du script -->

</body>
<!-- Fin du corps de la page -->

</html>
<!-- Fin du document HTML -->