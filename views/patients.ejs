<!DOCTYPE html>
<html>
<head>
    <title>Liste des Patients</title>
</head>
<body>
    <h1>Patients</h1>
    <ul>
        <% resultatPatients.forEach(patient => { %>
            <li><%= patient.nom %> <%= patient.prenom %></li>
        <% }) %>
    </ul>
    <a href="/api/accueil">Retour à l'accueil</a>
</body>
</html>

<!-- Titre de la page/formulaire -->
<h2>Ajouter un Patient</h2>

<!-- Formulaire qui envoie les données à la route POST /api/patients -->
<form action="/api/patients" method="POST">
    <!-- Champ pour le nom du patient -->
    <input type="text" name="nom" placeholder="Nom" required><br>

    <!-- Champ pour le prénom du patient -->
    <input type="text" name="prenom" placeholder="Prénom" required><br>

    <!-- Champ pour la date de naissance -->
    <input type="date" name="date_naissance" placeholder="Date de naissance" required><br>

    <!-- Champ pour le sexe -->
    <input type="text" name="sexe" placeholder="Sexe" required><br>

    <!-- Champ pour la date d'admission à l'hôpital -->
    <input type="date" name="date_admission" placeholder="Date d'admission" required><br>

    <!-- Champ pour le service affecté -->
    <input type="text" name="service_affecte" placeholder="Service affecté" required><br>

    <!-- Champ pour le statut du patient (ex: hospitalisé, sortie) -->
    <input type="text" name="statut" placeholder="Statut" required><br>

    <!-- Bouton pour envoyer le formulaire -->
    <button type="submit">Ajouter Patient</button>
</form>